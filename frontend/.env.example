# API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# Direct WebSocket host (optional). Set to a DNS-only sibling hostname to route
# WebSockets around a proxy while REST stays on the page origin. Unset = the
# page origin.
#VITE_WS_HOST=

# Feature Flags
VITE_ENABLE_NOTIFICATIONS=true

# Debug Mode
VITE_DEBUG=false
