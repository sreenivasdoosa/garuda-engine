# Copy to .env and edit. Never commit .env -- it is gitignored.
#
# Defaults assume a PostgreSQL on this machine with a `garuda` role and
# database:
#
#   sudo -u postgres psql -c "CREATE ROLE garuda LOGIN PASSWORD 'garuda';" \
#                        -c "CREATE DATABASE garuda OWNER garuda;"
#
# If you would rather not touch the system instance, `scripts/dev-db.sh up`
# runs one in a container on port 5433 -- set GARUDA_DB_PORT=5433 for that.

GARUDA_DB_HOST=localhost
GARUDA_DB_PORT=5432
GARUDA_DB_NAME=garuda
GARUDA_DB_USER=garuda
GARUDA_DB_PASSWORD=garuda

GARUDA_HOST=127.0.0.1
GARUDA_PORT=8080

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GARUDA_JWT_SECRET=

# Encrypts broker credentials at rest. Separate from the JWT secret on
# purpose: rotating this one makes every stored credential unreadable until
# it is re-entered, and nothing starts without it.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GARUDA_SECRET_KEY=
